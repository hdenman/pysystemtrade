#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $0 live|paper" >&2
    exit 2
}

[[ $# -eq 1 ]] || usage
role=$1
[[ $role == live || $role == paper ]] || usage

base_root=${PST_BASE_ROOT:-/srv/pysystemtrade}
instance_root=${PST_INSTANCE_ROOT:-$base_root/$role}
shared_root=${PST_SHARED_ROOT:-$base_root/shared-parquet}

if [[ ${PST_CHAIN_SKIP_PROFILE:-0} != 1 ]]; then
    # shellcheck disable=SC1090
    source "$instance_root/.profile"

    process=run_daily_chain
    stamp=$(date +%Y-%m-%d)
    echo_root=${ECHO:-$ECHO_PATH}
    echo_dir="$echo_root/$stamp"
    mkdir -p "$echo_dir"
    exec >> "$echo_dir/$process.txt" 2>&1
fi

python=${PST_PYTHON:-$PYSYSTEMTRADE_HOME/.devenv/state/venv/bin/python}
chain_date=${PST_CHAIN_DATE:-$(date +%F)}
ready_dir="$shared_root/.prices-ready"
ready_file="$ready_dir/$chain_date"

run_checked() {
    local wrapper=$1
    local process_name=$2
    local started_epoch

    started_epoch=$(date +%s)
    echo "Starting $process_name at $(date --iso-8601=seconds)"
    "$instance_root/bin/$wrapper"
    "$python" -m sysproduction.check_process_completion \
        "$process_name" "$started_epoch"
    echo "Completed $process_name at $(date --iso-8601=seconds)"
}

publish_prices_ready() {
    local temporary_file

    mkdir -p "$ready_dir"
    temporary_file="$ready_file.tmp.$$"
    trap 'rm -f "$temporary_file"' RETURN
    date --iso-8601=seconds > "$temporary_file"
    mv "$temporary_file" "$ready_file"
    trap - RETURN
    echo "Published shared-price readiness: $ready_file"
}

wait_for_prices() {
    local timeout_seconds=${PST_CHAIN_READY_TIMEOUT_SECONDS:-14400}
    local poll_seconds=${PST_CHAIN_READY_POLL_SECONDS:-60}
    local deadline=$((SECONDS + timeout_seconds))

    echo "Waiting for shared-price readiness: $ready_file"
    while [[ ! -f $ready_file ]]; do
        if (( SECONDS >= deadline )); then
            echo "Timed out waiting for shared-price readiness: $ready_file" >&2
            return 1
        fi
        sleep "$poll_seconds"
    done
    echo "Observed shared-price readiness: $ready_file"
}

if [[ $role == live ]]; then
    run_checked run-daily-price-updates run_daily_prices_updates
    run_checked run-daily-update-multiple-adjusted-prices \
        run_daily_update_multiple_adjusted_prices
    publish_prices_ready
else
    wait_for_prices
fi

run_checked run-backtest run_systems
run_checked generate-strategy-orders run_strategy_order_generator
run_checked run-cleaners run_cleaners
run_checked run-backups run_backups
run_checked run-reports run_reports
